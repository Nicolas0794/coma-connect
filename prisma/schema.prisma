generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  TEAM
  CLIENT
  CREATOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CREATOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  clientMembers  ClientMember[]
  creatorProfile Creator?
  contentReviews   ContentRevision[]  @relation("ContentReviewer")
  notifications    Notification[]
  campaignMessages CampaignMessage[]
  savedCreators    SavedCreator[]
  profileViews     ProfileView[]
  inquiryMessages  InquiryMessage[]

  // ── Academy ──
  enrollments     CourseEnrollment[]
  certificates    Certificate[]
  creatorSkills   CreatorSkill[]

  // ── Nation ──
  eventsOrganized  Event[]             @relation("EventOrganizer")
  eventSpeakerships EventSpeaker[]
  eventRegistrations EventRegistration[]

  // ── Crossover ──
  achievements UserAchievement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Whitelist para permitir signup con rol elevado (TEAM/ADMIN/CLIENT).
// Si un email NO está en esta tabla, el signup lo crea con rol CREATOR.
// Se consume al primer login; luego queda `usedAt` seteado para auditoría.
model InvitedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole
  invitedBy String?
  note      String?
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([role])
}

// Nichos normalizados (MEJORA-10). Antes: String[] libre con inconsistencias.
// Ahora: tabla canónica + junction tables. Creator.niches y Campaign.requiredNiches
// quedan en paralelo durante la transición; se escriben ambos.
model Niche {
  id        String   @id @default(cuid())
  slug      String   @unique
  labelEs   String
  labelEn   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  creators  CreatorNiche[]
  campaigns CampaignNiche[]

  @@index([active, order])
}

model CreatorNiche {
  creatorId String
  nicheId   String
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  niche   Niche   @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([creatorId, nicheId])
  @@index([nicheId])
}

model CampaignNiche {
  campaignId String
  nicheId    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  niche    Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([campaignId, nicheId])
  @@index([nicheId])
}

// Log de uso de Claude API — tracking de costos, latencia, éxito.
// Poblado por src/lib/claude.ts#logAiUsage en cada llamada.
model AiUsageLog {
  id            String   @id @default(cuid())
  feature       String   // "generate-brief" | "suggest-creators" | ...
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  stopReason    String?
  durationMs    Int      @default(0)
  success       Boolean
  errorMessage  String?
  entityType    String?  // "Campaign" | "Creator" | ...
  entityId      String?
  userId        String?
  createdAt     DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([model, createdAt])
}

// Leads de marcas que quieren sumarse a CoMa Connect.
// Flow: form público /sumar-marca → PENDING → TEAM revisa → APPROVED (crea InvitedEmail CLIENT + email) / REJECTED.
enum BrandLeadStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

model BrandLead {
  id           String           @id @default(cuid())
  brandName    String
  contactName  String
  contactEmail String
  contactPhone String?
  website      String?
  industry     String?
  message      String?
  source       String?          // referrer o campaign de origen
  status       BrandLeadStatus  @default(PENDING)
  reviewedBy   String?          // userId del team
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  industry  String?
  website   String?
  email     String?
  phone     String?
  logoUrl   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         ClientMember[]
  campaigns       Campaign[]
  clientCreators  ClientCreator[]
  portfolioItems  PortfolioItem[]
  creatorReviews  CreatorReview[]
  inquiries       Inquiry[]
}

// Comunidad de creadores que un cliente ya aceptó en campañas previas.
// Se populan automáticamente cuando CampaignCreator pasa a ACCEPTED.
model ClientCreator {
  id                 String   @id @default(cuid())
  clientId           String
  creatorId          String
  firstAcceptedAt    DateTime @default(now())
  lastCollaborationAt DateTime @default(now())
  campaignsCount     Int      @default(1)
  notes              String?

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([clientId, creatorId])
  @@index([clientId, lastCollaborationAt])
}

model ClientMember {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Creators
// ─────────────────────────────────────────────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
}

enum CreatorType {
  UGC
  INFLUENCER
  FILMMAKER
  PHOTOGRAPHER
  EDITOR
  STRATEGIST
  COPYWRITER
  DESIGNER
  MODEL
}

enum ContentFormat {
  REEL
  TIKTOK_VIDEO
  PHOTO
  LONG_VIDEO
  CAROUSEL
  LIVE
  PODCAST
  BLOG
}

enum Language {
  ES
  EN
  PT
}

enum CreatorAvailability {
  AVAILABLE
  LIMITED
  BUSY
  CLOSED
}

enum CreatorProfileStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

enum ProfileVisibility {
  PUBLIC
  CLIENTS_ONLY
  PRIVATE
}

model Creator {
  id               String   @id @default(cuid())
  userId           String?  @unique
  fullName         String
  email            String?
  phone            String?
  city             String?
  country          String?  @default("Colombia")
  bio              String?
  profileImageUrl  String?
  niches           String[] @default([])
  documentId       String?
  rutUrl           String?
  certBancariaUrl  String?
  docsCompleted    Boolean  @default(false)
  internalRating   Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ── Connect: identidad pública ──
  slug              String?  @unique
  artistName        String?
  headline          String?
  valuePitch        String?

  // ── Connect: clasificación ──
  creatorTypes      CreatorType[]   @default([])
  contentFormats    ContentFormat[] @default([])
  languages         Language[]      @default([])
  yearsOfExperience Int?

  // ── Connect: estado del perfil ──
  profileStatus       CreatorProfileStatus @default(DRAFT)
  profileVisibility   ProfileVisibility    @default(PRIVATE)
  profileCompleteness Int                  @default(0)
  publishedAt         DateTime?

  // ── Connect: disponibilidad y pricing (COP base, USD opcional) ──
  availability CreatorAvailability @default(AVAILABLE)
  showPricing  Boolean             @default(false)
  baseRateCOP  Decimal?            @db.Decimal(14, 2)
  baseRateUSD  Decimal?            @db.Decimal(10, 2)

  // ── Connect: verificaciones ──
  identityVerifiedAt DateTime?
  comaVerifiedAt     DateTime?

  // ── Connect: reputación agregada (denormalizada, recalculada vía trigger) ──
  avgRating    Float?
  reviewsCount Int    @default(0)

  // ── Connect: SEO ──
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // ── Connect: autofill desde redes (PROYECTO A) ──
  autofillSourceUrl String?
  autofillAt        DateTime?

  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  socialProfiles   CreatorSocialProfile[]
  campaignCreators CampaignCreator[]
  clientCreators   ClientCreator[]
  suggestions      CampaignSuggestion[]
  services         Service[]
  portfolioItems   PortfolioItem[]
  reviews          CreatorReview[]
  inquiries        Inquiry[]
  savedByUsers     SavedCreator[]
  profileViews     ProfileView[]
  nicheLinks       CreatorNiche[]

  @@index([profileStatus, profileVisibility])
  @@index([city, country])
}

model CreatorSocialProfile {
  id                    String         @id @default(cuid())
  creatorId             String
  platform              SocialPlatform
  handle                String
  url                   String?
  followers             Int?
  avgEngagement         Float?
  selfReportedFollowers Int?
  verifiedFollowers     Int?
  verifiedEngagement    Float?
  verifiedAt            DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

// ─────────────────────────────────────────────────────────────────────────────
// Campaigns
// ─────────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  PUBLISHING
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String         @id @default(cuid())
  clientId        String
  code            String         @unique
  name            String
  status          CampaignStatus @default(DRAFT)
  objective       String?
  budget          Decimal?       @db.Decimal(14, 2)
  startDate       DateTime?
  endDate         DateTime?
  briefOriginal   String?
  briefOptimized  String?

  // Perfil de creador buscado — usado por la IA para sugerencias
  requiredNiches       String[]         @default([])
  requiredCity         String?
  minFollowers         Int?
  requiredPlatform     SocialPlatform?
  requiredAudienceDesc String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  campaignCreators CampaignCreator[]
  messages         CampaignMessage[]
  attachments      CampaignAttachment[]
  suggestions      CampaignSuggestion[]
  inquiries        Inquiry[]
  nicheLinks       CampaignNiche[]
}

model CampaignAttachment {
  id         String   @id @default(cuid())
  campaignId String
  fileUrl    String
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, uploadedAt])
}

// Sugerencias de creadoras generadas por la IA al crear la campaña,
// persistidas para mostrarlas al cliente sin re-consultar al modelo.
model CampaignSuggestion {
  id            String   @id @default(cuid())
  campaignId    String
  creatorId     String
  fromCommunity Boolean  @default(false)
  score         Int      @default(0)
  reason        String
  createdAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@index([campaignId, score])
}

enum CampaignCreatorStatus {
  INVITED
  ACCEPTED
  DECLINED
  ONBOARDING
  ACTIVE
  COMPLETED
  REMOVED
}

model CampaignCreator {
  id                     String                @id @default(cuid())
  campaignId             String
  creatorId              String
  status                 CampaignCreatorStatus @default(INVITED)
  fee                    Decimal?              @db.Decimal(14, 2)
  invitedAt              DateTime              @default(now())
  acceptedAt             DateTime?
  onboardingCompletedAt  DateTime?
  completedAt            DateTime?
  notes                  String?

  // Rating del cliente al finalizar la campaña (1-5 estrellas)
  clientRating           Int?
  clientFeedback         String?
  ratedAt                DateTime?

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  contentPieces ContentPiece[]
  payment       Payment?
  review        CreatorReview?

  @@unique([campaignId, creatorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

enum ContentType {
  REEL
  POST
  STORY
  CAROUSEL
  VIDEO
}

enum ContentStatus {
  IDEA
  SCRIPT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ContentPiece {
  id                  String         @id @default(cuid())
  campaignCreatorId   String
  title               String
  type                ContentType
  platform            SocialPlatform
  status              ContentStatus  @default(IDEA)
  description         String?
  script              String?
  caption             String?
  plannedPublishDate  DateTime?
  actualPublishDate   DateTime?
  publishedUrl        String?

  // Timestamps de transición para análisis de velocidad/comportamiento
  firstSubmittedAt    DateTime?
  approvedAt          DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  campaignCreator CampaignCreator    @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  revisions       ContentRevision[]
  metrics         ContentMetric[]
  portfolioItem   PortfolioItem?
}

model ContentRevision {
  id             String   @id @default(cuid())
  contentPieceId String
  version        Int
  body           String
  feedback       String?
  reviewerId     String?
  createdAt      DateTime @default(now())

  contentPiece ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("ContentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([contentPieceId, version])
}

model ContentMetric {
  id             String   @id @default(cuid())
  contentPieceId String
  views          Int?
  likes          Int?
  comments       Int?
  saves          Int?
  shares         Int?
  reach          Int?
  impressions    Int?
  capturedAt     DateTime @default(now())

  contentPiece ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)

  @@index([contentPieceId, capturedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  DOCS_SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum PaymentDocumentType {
  CUENTA_DE_COBRO
  RUT
  CERTIFICACION_BANCARIA
}

model Payment {
  id                String        @id @default(cuid())
  campaignCreatorId String        @unique
  amount            Decimal       @db.Decimal(14, 2)
  status            PaymentStatus @default(PENDING)
  dueDate           DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  campaignCreator CampaignCreator   @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  documents       PaymentDocument[]
}

model PaymentDocument {
  id         String              @id @default(cuid())
  paymentId  String
  type       PaymentDocumentType
  fileUrl    String
  fileName   String?
  uploadedAt DateTime            @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  link      String?
  read      Boolean             @default(false)
  sentAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, sentAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Campaign Chat
// ─────────────────────────────────────────────────────────────────────────────

model CampaignMessage {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Connect — capa pública: servicios, portafolio, reputación, inquiries
// ─────────────────────────────────────────────────────────────────────────────

enum InquiryStatus {
  PENDING
  VIEWED
  QUOTED
  ACCEPTED
  REJECTED
  CONVERTED_TO_CAMPAIGN
  EXPIRED
}

model Service {
  id           String        @id @default(cuid())
  creatorId    String
  title        String
  description  String?
  format       ContentFormat?
  priceCOP     Decimal?      @db.Decimal(14, 2)
  priceUSD     Decimal?      @db.Decimal(10, 2)
  deliveryDays Int?
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, isActive])
}

model PortfolioItem {
  id               String         @id @default(cuid())
  creatorId        String
  title            String
  description      String?
  format           ContentFormat?
  brandName        String?
  clientId         String?
  contentPieceId   String?        @unique
  externalUrl      String?
  coverImageUrl    String?
  mediaUrls        String[]       @default([])
  views            Int?
  engagement       Float?
  isVerifiedByComa Boolean        @default(false)
  isFeatured       Boolean        @default(false)
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contentPiece ContentPiece? @relation(fields: [contentPieceId], references: [id], onDelete: SetNull)

  @@index([creatorId, order])
  @@index([creatorId, isFeatured])
}

model CreatorReview {
  id                String   @id @default(cuid())
  creatorId         String
  clientId          String
  campaignCreatorId String   @unique
  rating            Int
  feedback          String?
  isPublic          Boolean  @default(true)
  creatorResponse   String?
  creatorResponseAt DateTime?
  createdAt         DateTime @default(now())

  creator         Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([creatorId, rating])
}

model Inquiry {
  id           String        @id @default(cuid())
  creatorId    String
  clientId     String?
  contactEmail String
  contactName  String
  contactPhone String?
  brief        String
  budgetCOP    Decimal?      @db.Decimal(14, 2)
  deadline     DateTime?
  status       InquiryStatus @default(PENDING)
  campaignId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creator  Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  client   Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  quotes   Quote[]
  messages InquiryMessage[]

  @@index([creatorId, status, createdAt])
}

model Quote {
  id           String    @id @default(cuid())
  inquiryId    String
  priceCOP     Decimal   @db.Decimal(14, 2)
  scope        String
  deliveryDays Int?
  terms        String?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model InquiryMessage {
  id        String   @id @default(cuid())
  inquiryId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model SavedCreator {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
}

model ProfileView {
  id        String   @id @default(cuid())
  creatorId String
  viewerId  String?
  source    String?
  viewedAt  DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([creatorId, viewedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Academy — cursos, progreso, certificaciones, skills
// ─────────────────────────────────────────────────────────────────────────────

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SkillCategory {
  STORYTELLING
  PRODUCTION
  EDITING
  STRATEGY
  BRAND
  TECH
  SOFT
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  category SkillCategory
  createdAt DateTime     @default(now())

  courses        CourseSkill[]
  creatorSkills  CreatorSkill[]
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  summary     String?
  description String?
  coverUrl    String?
  level       CourseLevel  @default(BEGINNER)
  status      CourseStatus @default(DRAFT)
  durationMin Int?
  priceCOP    Decimal?     @db.Decimal(14, 2)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules     CourseModule[]
  enrollments CourseEnrollment[]
  skills      CourseSkill[]

  @@index([status, publishedAt])
}

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  title    String
  summary  String?
  order    Int     @default(0)

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id          String  @id @default(cuid())
  moduleId    String
  title       String
  videoUrl    String?
  bodyMd      String?
  durationMin Int?
  order       Int     @default(0)

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId, order])
}

model CourseSkill {
  id       String @id @default(cuid())
  courseId String
  skillId  String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ENROLLED)
  progressPct Int              @default(0)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
  certificate  Certificate?

  @@unique([userId, courseId])
  @@index([userId, status])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model Certificate {
  id              String   @id @default(cuid())
  enrollmentId    String   @unique
  userId          String
  certificateUrl  String?
  skillsEarned    String[] @default([])
  issuedAt        DateTime @default(now())

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
}

// Skill declarada por la creadora (auto-reportada, no ganada)
model CreatorSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Int      @default(1) // 1-5 self-reported
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Nation — eventos, asistencia, networking
// ─────────────────────────────────────────────────────────────────────────────

enum EventType {
  MEETUP
  WORKSHOP
  PANEL
  PARTY
  CONFERENCE
  WEBINAR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  WAITLIST
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum SpeakerRole {
  SPEAKER
  PANELIST
  HOST
  SPECIAL_GUEST
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  type        EventType   @default(MEETUP)
  city        String?
  venue       String?
  startAt     DateTime
  endAt       DateTime?
  capacity    Int?
  coverUrl    String?
  status      EventStatus @default(DRAFT)
  organizerId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer     User?               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  speakers      EventSpeaker[]
  registrations EventRegistration[]
  tags          EventTag[]

  @@index([status, startAt])
  @@index([city, startAt])
}

model EventSpeaker {
  id      String      @id @default(cuid())
  eventId String
  userId  String
  role    SpeakerRole @default(SPEAKER)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventRegistration {
  id             String             @id @default(cuid())
  eventId        String
  userId         String
  status         RegistrationStatus @default(REGISTERED)
  registeredAt   DateTime           @default(now())
  attendedAt     DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model EventTag {
  id      String @id @default(cuid())
  eventId String
  tag     String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tag])
  @@index([tag])
}

// ─────────────────────────────────────────────────────────────────────────────
// Crossover — timeline unificado de logros del usuario
// ─────────────────────────────────────────────────────────────────────────────

enum AchievementType {
  CAMPAIGN_COMPLETED
  COURSE_COMPLETED
  EVENT_ATTENDED
  EVENT_SPEAKER
  CERTIFICATE_EARNED
  BADGE_EARNED
}

model UserAchievement {
  id          String          @id @default(cuid())
  userId      String
  type        AchievementType
  title       String
  description String?
  emoji       String?
  sourceId    String?         // id de Campaign, Course, Event, etc.
  linkUrl     String?
  isPublic    Boolean         @default(true)
  issuedAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
  @@index([userId, type])
}
